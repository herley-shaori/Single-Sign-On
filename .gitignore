# ---- Terraform ------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.lock.hcl is intentionally NOT ignored (best practice: commit
# the lock file so provider versions stay reproducible).

# ---- Secrets / credentials ------------------------------------------------
# Never commit files holding Azure / AWS / GCP credentials.
*.tfvars.secret
*.secret
*.secrets
.env
.envrc
credentials
credentials.json

# GCP service account JSON files (multiple patterns for defense in depth).
**/sa.json
**/service-account.json
**/*-service-account.json
**/*-credentials.json
**/.credentials.json

# ---- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
