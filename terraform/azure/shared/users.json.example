{
  "_comment": "Source of truth for Azure AD users managed by terraform. Key = user_principal_name (UPN). given_name and surname are REQUIRED because SCIM provisioning to AWS IAM Identity Center needs name.givenName and name.familyName. group_memberships = list of group display_names; each name must exist in local.managed_groups in main.tf.",

  "users": {
    "user1@example.com": {
      "display_name":      "User One",
      "given_name":        "User",
      "surname":           "One",
      "mail_nickname":     "user1",
      "group_memberships": ["developers"]
    },
    "user2@example.com": {
      "display_name":      "User Two",
      "given_name":        "User",
      "surname":           "Two",
      "mail_nickname":     "user2",
      "group_memberships": ["data_scientists"]
    }
  }
}
